---
/**
 * The three-bar menu glyph. The site header's mobile dropdown and the docs
 * drawer toggle each carried a byte-identical inline copy; this is the one
 * definition. Decorative only — every caller supplies its own accessible name
 * on the interactive element that wraps it.
 */
---

<svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
  <g fill="currentColor">
    <rect x="8" y="10" width="32" height="4"></rect>
    <rect x="8" y="22" width="32" height="4"></rect>
    <rect x="8" y="34" width="32" height="4"></rect>
  </g>
</svg>
