---
interface Props {
  code: string;
  label?: string;
  /** Show the copy-to-clipboard button. Default true. */
  copyable?: boolean;
}

const { code, label = 'shell', copyable = true } = Astro.props;
---

{/* role="group", not role="region": the per-service API reference pages render
    one of these per method (100+ landmarks on a single document), which turns a
    screen reader's landmark list into noise. The label still names the window. */}
<div class="code-window" role="group" aria-label={`${label} command`}>
  <div class="code-window-bar mb-2 flex items-center justify-between gap-3">
    <span class="code-window-label kbd kbd-sm">{label}</span>
    <span class="code-window-tools flex items-center gap-2">
      <span class="terminal-caret" aria-hidden="true"></span>
      {
        copyable && (
          <button class="copy-button" type="button" data-copy aria-label={`Copy the ${label} command to the clipboard`}>
            <span class="copy-glyph" aria-hidden="true" />
            <span class="copy-text" data-copy-state>Copy</span>
          </button>
        )
      }
    </span>
  </div>
  <pre><code>{code}</code></pre>
</div>
