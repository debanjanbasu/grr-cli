---
import InlineCode from './InlineCode.astro';

interface Props {
  eyebrow: string;
  title: string;
  copy: string;
  id?: string;
}

const { eyebrow, title, copy, id } = Astro.props;
---

<div class="section-heading section-intro">
  <span class="eyebrow">{eyebrow}</span>
  <h2 id={id}><InlineCode text={title} /></h2>
  <p><InlineCode text={copy} /></p>
</div>
