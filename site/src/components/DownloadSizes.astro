---
import stats from '../data/stats.json';

type PlatformKey = 'linux-x86_64' | 'macos-aarch64' | 'windows-x86_64' | 'windows-aarch64';

interface Props {
  /** Suffix line under the row. Set to an empty string to drop it. */
  note?: string;
}

const { note = 'Compressed release archives, straight from the GitHub release.' } = Astro.props;

const platforms: { key: PlatformKey; label: string }[] = [
  { key: 'linux-x86_64', label: 'Linux x86_64' },
  { key: 'macos-aarch64', label: 'macOS arm64' },
  { key: 'windows-x86_64', label: 'Windows x86_64' },
  { key: 'windows-aarch64', label: 'Windows ARM' },
];

// `binarySizes` is optional: older snapshots predate it, and a release is free
// to omit a platform. Either way the row renders, with an em dash for the gap.
const sizes = (stats.binarySizes ?? {}) as Partial<Record<PlatformKey, number>>;

const formatMegabytes = (bytes: number | undefined) => {
  const size = Number(bytes);
  if (!Number.isFinite(size) || size <= 0) return '—';
  return `${(size / 1024 / 1024).toFixed(1)} MB`;
};

const release = String(stats.latestRelease || `v${stats.version}`).replace(/^v/, '');
const rows = platforms.map(({ key, label }) => ({ label, size: formatMegabytes(sizes[key]) }));
---

<div class="download-sizes mt-4">
  <div class="download-sizes-head mb-1 flex items-center justify-between gap-4">
    <span class="stat-label">download sizes</span>
    <span class="badge badge-secondary badge-sm">v{release}</span>
  </div>
  <dl class="download-sizes-grid grid grid-cols-2 gap-x-6 gap-y-3 m-0 sm:grid-cols-4">
    {
      rows.map((row) => (
        <div class="download-sizes-cell">
          <dt class="text-xs text-(--muted)">{row.label}</dt>
          <dd class="m-0 mt-0.5 text-lg">{row.size}</dd>
        </div>
      ))
    }
  </dl>
  {note && <p class="download-sizes-note m-0 mt-3 text-xs text-(--quiet)">{note}</p>}
</div>
