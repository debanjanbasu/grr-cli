---
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer border-t border-base-300 bg-base-200">
  <div class="container footer footer-vertical sm:footer-horizontal w-full gap-12 py-14">
    <div class="footer-identity">
      <a class="footer-brand inline-flex items-center gap-3 no-underline" href={base}>
        <img src={`${base}logo.svg`} alt="" width="64" height="64" class="h-10 w-10" />
        <span class="text-lg">grr</span>
      </a>
      <p class="footer-tagline mt-2 text-sm text-(--muted)">Google tools from the terminal.</p>
    </div>
    <nav class="grid w-full grid-cols-2 gap-10 sm:grid-cols-3 sm:w-auto" aria-label="Footer navigation">
      <div class="footer-links">
        <span class="footer-title">Explore</span>
        <a class="link link-hover" href={base}>Overview</a>
        <a class="link link-hover" href={`${base}install/`}>Install</a>
        <a class="link link-hover" href={`${base}docs/`}>Docs</a>
        <a class="link link-hover" href={`${base}changelog/`}>Changelog</a>
        <a class="link link-hover" href={`${base}compare/`}>Compare</a>
        <a class="link link-hover" href={`${base}llms.txt`}>llms.txt</a>
        <a class="link link-hover" href="https://crates.io/crates/grr-cli" target="_blank" rel="noreferrer">crates.io ↗</a>
        <a class="link link-hover" href="https://docs.rs/grr-cli" target="_blank" rel="noreferrer">API docs ↗</a>
      </div>
      <div class="footer-links">
        <span class="footer-title">Reference</span>
        <a class="link link-hover" href={`${base}docs/getting-started/`}>Getting started</a>
        <a class="link link-hover" href={`${base}docs/commands/`}>Commands</a>
        <a class="link link-hover" href={`${base}docs/discovery/`}>Discovery API</a>
        <a class="link link-hover" href={`${base}docs/agents/`}>For agents</a>
      </div>
      <div class="footer-links">
        <span class="footer-title">Project</span>
        <a class="link link-hover" href="https://github.com/debanjanbasu/grr-cli" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a class="link link-hover" href={`${base}privacy/`}>Privacy</a>
        <a class="link link-hover" href={`${base}terms/`}>Terms</a>
      </div>
    </nav>
  </div>
  <div class="container grid gap-1 border-t border-base-300 py-6 text-xs text-(--quiet) sm:flex sm:items-center sm:justify-between">
    <p class="m-0">grr is an independent project and is not affiliated with, sponsored by, or endorsed by Google LLC.</p>
    <p class="m-0">MIT licensed · built for the terminal</p>
    <p class="footer-fonts m-0">Type: IBM 3270 · BSD 3-Clause · github.com/rbanffy/3270font</p>
  </div>
</footer>
