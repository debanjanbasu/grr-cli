---
import BaseLayout from '../layouts/BaseLayout.astro';
import benchmarksJson from '../data/benchmarks.json';

// The snapshot is regenerated by scripts/benchmark.mjs and may legitimately
// be missing any metric (a command absent from the binary, a competitor that
// could not be obtained). Every read below guards for that: the page must
// render the honest subset, never invent the rest.
interface Timing {
  available: boolean;
  medianMs?: number;
  p95Ms?: number;
  minMs?: number;
  reason?: string;
}

interface Binary {
  bytes?: number;
  source?: string;
  form?: string;
  available?: boolean;
  reason?: string;
}

interface CompetitorRow {
  tool: string;
  project?: string;
  url?: string;
  available: boolean;
  obtainedVia?: string;
  version?: string;
  reason?: string;
  startup?: Timing;
  binary?: Binary;
}

interface Benchmarks {
  generatedAt?: string;
  environment?: {
    platform?: string;
    arch?: string;
    nodeVersion?: string;
    binaryKind?: string;
    binaryPath?: string;
    grrVersion?: string;
  };
  versions?: Record<string, { local?: string | null; latestTag?: string | null; latestTagReason?: string }>;
  protocol?: { runs?: number; warmupRunsDiscarded?: number; stability?: string };
  grr?: {
    startup?: Timing;
    schemaDump?: Timing;
    apiList?: Timing;
    binary?: Binary;
  };
  competitors?: CompetitorRow[];
}

const benchmarks = benchmarksJson as Benchmarks;
const { environment, protocol } = benchmarks;
const versions = benchmarks.versions ?? {};
const grr = benchmarks.grr ?? {};
const competitors = Array.isArray(benchmarks.competitors) ? benchmarks.competitors : [];
const availableCompetitors = competitors.filter((row) => row.available && row.startup?.available);
const unavailableCompetitors = competitors.filter((row) => !availableCompetitors.includes(row));

// Latest release tags recorded by the benchmark: shown next to the measured
// versions so the page states both what ran and where each project stood.
const latestReleases = ['grr', 'gog', 'gws']
  .map((tool) => (versions[tool]?.latestTag ? `${tool} ${versions[tool].latestTag}` : null))
  .filter((entry): entry is string => Boolean(entry))
  .join(' · ');

const generatedAt = benchmarks.generatedAt ?? '';
const generatedDate = new Date(generatedAt);
const generatedLabel = Number.isNaN(generatedDate.getTime())
  ? 'unknown'
  : generatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const ms = (value: number | undefined) => (Number.isFinite(value) ? `${value} ms` : '—');
const megabytes = (bytes: number | undefined) =>
  typeof bytes === 'number' && Number.isFinite(bytes) ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : '—';

const timingDetail = (metric: Timing | undefined) => {
  if (!metric?.available) return `not in this snapshot — ${metric?.reason ?? 'not measured'}`;
  return `p95 ${ms(metric.p95Ms)} · min ${ms(metric.minMs)}`;
};

// grr-facing cards: whatever the snapshot actually contains.
const cards = [
  { label: 'startup · grr --version', value: grr.startup?.available ? ms(grr.startup?.medianMs) : '—', detail: timingDetail(grr.startup) },
  { label: 'schema dump · grr schema', value: grr.schemaDump?.available ? ms(grr.schemaDump?.medianMs) : '—', detail: timingDetail(grr.schemaDump) },
  { label: 'api index · grr api list', value: grr.apiList?.available ? ms(grr.apiList?.medianMs) : '—', detail: timingDetail(grr.apiList) },
  {
    label: 'binary size',
    value: megabytes(grr.binary?.bytes),
    detail: grr.binary?.form === 'binary' ? 'unpacked executable' : grr.binary?.form === 'release-archive' ? 'release archive' : grr.binary?.source ?? '',
  },
];

// Columns of the numeric comparison: grr plus every competitor that actually
// produced startup numbers on this snapshot.
const columns = [
  { name: 'grr', version: environment?.grrVersion ?? '', startup: grr.startup, binary: grr.binary },
  ...availableCompetitors.map((row) => ({ name: row.tool, version: row.version ?? '', startup: row.startup, binary: row.binary })),
];

// ---------------------------------------------------------------------------
// Feature matrix. Every cell cites the project's own documentation or a
// running release binary (sources listed under the table). Cells we could
// not verify say "Not documented" — that is a claim about their docs, not a
// measured absence in the tool.
// ---------------------------------------------------------------------------

interface Cell {
  text: string;
  kind?: 'yes' | 'no' | 'gap' | 'na';
}

const matrix: { label: string; cells: [Cell, Cell, Cell, Cell] }[] = [
  {
    label: 'Coverage',
    cells: [
      { text: '308 methods across 10 APIs — generated from a Discovery index committed to the repo, works offline', kind: 'yes' },
      { text: '27 services, incl. Classroom, Meet, Analytics, Ads, YouTube', kind: 'yes' },
      { text: 'Every Workspace API — command surface built from Google’s live Discovery Service at runtime', kind: 'yes' },
      { text: 'n/a — fixed per-product toolsets', kind: 'na' },
    ],
  },
  {
    label: 'HTTP/3 (QUIC)',
    cells: [
      { text: 'Always on, HTTP/2 fallback', kind: 'yes' },
      { text: 'Not documented', kind: 'na' },
      { text: 'Not documented', kind: 'na' },
      { text: 'n/a', kind: 'na' },
    ],
  },
  {
    label: 'Zero-config OAuth',
    cells: [
      { text: 'Yes — release binaries ship the client compiled in (source builds run grr auth setup)', kind: 'yes' },
      { text: 'No — create your own Desktop OAuth client in Google Cloud', kind: 'no' },
      { text: 'No — GCP project + OAuth client required (auth setup)', kind: 'no' },
      { text: 'No — own GCP project, OAuth consent screen and Web client per server', kind: 'no' },
    ],
  },
  {
    label: 'Runtime dependencies',
    cells: [
      { text: 'None — single static binary', kind: 'yes' },
      { text: 'None — single binary', kind: 'yes' },
      { text: 'None installed — but the command surface is built from live Discovery at runtime', kind: 'yes' },
      { text: 'No CLI to install — any MCP client', kind: 'na' },
    ],
  },
  {
    label: 'MCP server',
    cells: [
      { text: 'Not yet', kind: 'gap' },
      { text: 'Yes — gog mcp, typed stdio, read-only by default', kind: 'yes' },
      { text: 'Not documented', kind: 'na' },
      { text: 'Is one — hosted remote servers (Developer Preview)', kind: 'yes' },
    ],
  },
  {
    label: 'Agent skills',
    cells: [
      { text: 'Not yet', kind: 'gap' },
      { text: 'Yes — schema, reference pages and skills generated from the same command tree', kind: 'yes' },
      { text: 'Yes — 100+ SKILL.md files, one per API, plus 50 curated recipes', kind: 'yes' },
      { text: 'n/a — agents connect directly via MCP', kind: 'na' },
    ],
  },
  {
    label: 'Multi-account',
    cells: [
      { text: 'Not yet', kind: 'gap' },
      { text: 'Yes — accounts, aliases, keyring-stored tokens', kind: 'yes' },
      { text: 'Not documented', kind: 'na' },
      { text: 'n/a', kind: 'na' },
    ],
  },
  {
    label: 'Language',
    cells: [
      { text: 'Rust' },
      { text: 'Go' },
      { text: 'Rust' },
      { text: 'Hosted service', kind: 'na' },
    ],
  },
  {
    label: 'License',
    cells: [
      { text: 'MIT' },
      { text: 'MIT' },
      { text: 'Apache-2.0' },
      { text: 'Developer Preview terms', kind: 'na' },
    ],
  },
];

const columnHeads = ['grr', 'gog', 'gws', 'Google Workspace MCP servers'];
---

<BaseLayout
  title="Compare"
  description="Startup, schema-dump and api-index timings plus binary sizes for grr, gog and gws, measured daily in CI without credentials, and a feature matrix verified against each project's own docs."
>
  <section class="section page-hero">
    <div class="container page-hero-grid">
      <div class="reveal">
        <span class="eyebrow">honest comparison</span>
        <h1>Compare</h1>
        <p>
          grr measured against the other Google Workspace CLIs. Every number below was actually run —
          no vendor benchmarks, no estimates. Where grr is behind, the table says so; where a claim
          could not be verified, it says that instead.
        </p>
      </div>
      <p class="page-hero-aside reveal">
        snapshot <time datetime={generatedAt}>{generatedLabel}</time>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="read-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <span class="eyebrow">method</span>
          <h2 id="read-title">How to read this</h2>
        </div>
      </div>
      <div class="compare-read">
        <p>
          Measured metrics are credential-free by design: process startup (<code>--version</code>), the
          <code>grr schema</code> JSON contract dump, the <code>grr api list</code> method index and
          binary size on disk. Nothing here needs a Google account or a network round-trip, which is
          what makes a daily CI benchmark possible without flakes.
        </p>
        <p>
          Protocol per metric: the first run is a discarded warm-up, then
          {protocol?.runs ?? 15}
          timed runs using <code>process.hrtime.bigint()</code> around the process; median, p95 and
          min are reported. Every tool gets the identical protocol on the same machine. A run whose
          medians land within the noise band (max(15 ms, 6%)) of the committed snapshot rewrites
          nothing, so small differences are noise, not news. The benchmark re-runs whenever a new
          version of grr, gog or gws ships — the workflow watches each project's release tags and
          rebuilds on change — so the numbers follow the tools rather than a one-time snapshot.
        </p>
        <p>
          Feature matrix cells are verified against each project's own documentation and, where
          possible, a running release binary — sources are listed under the table. "Not documented"
          means exactly that: the claim could not be verified from their docs, so it is neither
          confirmed nor denied.
        </p>
      </div>
      <dl class="compare-env">
        <div>
          <dt>measured on</dt>
          <dd>{environment?.platform ?? 'unknown'} / {environment?.arch ?? 'unknown'}</dd>
        </div>
        <div>
          <dt>grr binary</dt>
          <dd>{environment?.binaryKind ?? 'none'}{environment?.grrVersion ? ` · ${environment.grrVersion}` : ''}</dd>
        </div>
        <div>
          <dt>latest releases</dt>
          <dd>{latestReleases || 'unknown'}</dd>
        </div>
        <div>
          <dt>node</dt>
          <dd>{environment?.nodeVersion ?? 'unknown'}</dd>
        </div>
        <div>
          <dt>warm-up</dt>
          <dd>{protocol?.warmupRunsDiscarded ?? 1} run discarded per metric</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="measured-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <span class="eyebrow">measured, not guessed</span>
          <h2 id="measured-title">The numbers</h2>
        </div>
        <p>Medians of {protocol?.runs ?? 15} runs on the machine named above. A missing card value means the command is not present in the measured binary — the reason is printed, never padded.</p>
      </div>

      <div class="stats-grid">
        {
          cards.map((card) => (
            <article class="stat-card">
              <span class="stat-label">{card.label}</span>
              <strong class="stat-value">{card.value}</strong>
              <span class="stat-detail">{card.detail}</span>
            </article>
          ))
        }
      </div>

      {
        columns.length > 1 ? (
          <div class="compare-table-wrap">
            <table class="compare-table">
              <caption class="stat-label">
                startup time (<code>--version</code>) and unpacked binary size, identical protocol per tool
              </caption>
              <thead>
                <tr>
                  <th scope="col">tool</th>
                  <th scope="col">startup median</th>
                  <th scope="col">startup p95</th>
                  <th scope="col">startup min</th>
                  <th scope="col">binary size</th>
                </tr>
              </thead>
              <tbody>
                {columns.map((column) => (
                  <tr>
                    <th scope="row">
                      {column.name}
                      {column.version && <span class="compare-version">{column.version}</span>}
                    </th>
                    <td>{ms(column.startup?.available ? column.startup?.medianMs : undefined)}</td>
                    <td>{ms(column.startup?.available ? column.startup?.p95Ms : undefined)}</td>
                    <td>{ms(column.startup?.available ? column.startup?.minMs : undefined)}</td>
                    <td>{megabytes(column.binary?.bytes)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="compare-absent">
            No competitor tool could be obtained and run for this snapshot, so the numeric comparison
            shows grr alone. Nothing was invented for tools that could not run — that is the point.
            The benchmark keeps trying on every daily run and the table appears as soon as one does.
          </p>
        )
      }

      {
        unavailableCompetitors.length > 0 && (
          <ul class="compare-unavailable">
            {unavailableCompetitors.map((row) => (
              <li>
                <code>{row.tool}</code> unavailable for this snapshot — {row.reason}
              </li>
            ))}
          </ul>
        )
      }

      <p class="stats-footnote">
        <span class="status-dot" aria-hidden="true"></span>
        <span>
          Snapshot generated <time datetime={generatedAt}>{generatedLabel}</time>
          {environment?.binaryKind === 'release' || environment?.binaryKind === 'debug'
            ? ` from a locally built ${environment.binaryKind} binary`
            : ''}
          . Competitor binaries are their official GitHub release builds, as shipped.
        </span>
        <a href="https://github.com/debanjanbasu/grr-cli/blob/main/scripts/benchmark.mjs">
          The benchmark script <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="matrix-title">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <span class="eyebrow">feature matrix</span>
          <h2 id="matrix-title">What each tool actually offers</h2>
        </div>
        <p>
          Verified against each project's own documentation and release binaries. grr's gaps are
          marked as gaps — they are real.
        </p>
      </div>

      <div class="compare-table-wrap">
        <table class="compare-table compare-matrix">
          <thead>
            <tr>
              <th scope="col">feature</th>
              {columnHeads.map((head) => (
                <th scope="col">{head}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              matrix.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell) => (
                    <td class={cell.kind ? `is-${cell.kind}` : undefined}>{cell.text}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="compare-read">
        <p>
          Where the others win: <a href="https://github.com/steipete/gogcli">gog</a> covers 27
          services — including Classroom, Meet and Analytics, which grr does not touch yet — and it
          already ships an MCP server (<code>gog mcp</code>) and multi-account routing today.
          <a href="https://github.com/googleworkspace/cli">gws</a> rebuilds its entire command
          surface from Google's live Discovery Service — when Google adds a method, gws has it
          without a release — and ships 100+ agent skills. Google's
          <a href="https://developers.google.com/workspace/guides/configure-mcp-servers">
            remote MCP servers
          </a>
          need no local install at all.
        </p>
        <p>
          Where grr bets differently: the full 308-method surface is generated from a Discovery
          index that is committed to the repository — reviewable in a diff, working offline — rather
          than fetched at runtime; HTTP/3 as the only transport, OAuth compiled into release
          binaries so first run is zero-config, a small static binary with no runtime dependencies,
          and a machine-readable <code>schema</code> contract for agents. An MCP server and agent
          skills are on the roadmap, not on this page.
        </p>
        <p class="compare-sources">
          Sources: gog cells from its README (quick start, accounts, MCP guide) plus
          <code>gog auth services</code> and <code>gog --help</code> on the v0.42.0 release binary;
          gws cells from its README and <code>gws --help</code> / <code>gws auth --help</code> on the
          0.22.5 release binary and its LICENSE file; Google server cells from Google's
          configure-mcp-servers guide (Developer Preview); grr cells from this repository.
          Unverifiable claims are labelled "Not documented" rather than guessed.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .compare-read {
    max-width: 72ch;
  }

  .compare-read p {
    margin: 0 0 14px;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.75;
  }

  .compare-read a {
    color: var(--accent-text);
  }

  .compare-env {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 22px 0 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .compare-env dt {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
  }

  .compare-env dd {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--ink);
  }

  .compare-table-wrap {
    margin-top: 28px;
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .compare-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .compare-table caption {
    text-align: left;
    padding: 14px 16px 0;
  }

  .compare-table th,
  .compare-table td {
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .compare-table thead th {
    border-top: none;
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Row labels read as labels, not data. */
  .compare-table tbody th[scope='row'] {
    color: var(--ink);
    white-space: nowrap;
  }

  .compare-matrix tbody th[scope='row'] {
    font-weight: normal;
  }

  .compare-version {
    display: block;
    margin-top: 2px;
    color: var(--quiet);
    font-size: 11px;
    font-weight: normal;
    white-space: normal;
  }

  .compare-table td.is-yes {
    color: var(--ink);
  }

  .compare-table td.is-gap {
    color: var(--accent-text);
    font-weight: bold;
  }

  .compare-table td.is-no,
  .compare-table td.is-na {
    color: var(--muted);
  }

  .compare-absent {
    margin: 24px 0 0;
    max-width: 72ch;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.75;
  }

  .compare-unavailable {
    margin: 14px 0 0;
    padding: 0 0 0 18px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .compare-sources {
    color: var(--quiet);
  }
</style>
