# Rust target directory
/target/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.dll
*.exe
*.so
*.dylib

# Test coverage
coverage/
*.profdata

# Cargo cache
.cargo/registry/
.cargo/git/

# Benchmark results
*.bench

# Environment files
.env
.env.local
# .env.example is the documented template and IS tracked
!.env.example

# Temporary files
*.tmp
*.temp
# Local gmail config (contains OAuth secrets)
.config/

# Node (root scripts toolchain: typescript, @types/node)
/node_modules/

/site/node_modules/
/site/dist/
/site/.astro/

# Release staging scratch. release-binaries.yml builds into /stage and
# archives out of /dist; a local replay of that workflow leaves both behind,
# and untracked build output in the tree root is noise at best and a
# accidentally-committed 30MB tarball at worst.
/stage/
/dist/
