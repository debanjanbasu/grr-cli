# Rust target directory
/target/

# Cargo.lock is deliberately untracked: every build resolves the latest
# semver-compatible dependency versions instead of pinning an old lockfile.
/Cargo.lock

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.dll
*.exe
*.so
*.dylib

# Environment files
.env

# Node (root scripts toolchain: typescript, @types/node)
/node_modules/

/site/node_modules/
/site/dist/
/site/.astro/

